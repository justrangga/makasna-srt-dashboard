[Unit]
Description=Makasna SRT and RTMP Relay Dashboard
After=network-online.target mediamtx.service
Wants=network-online.target

[Service]
Type=simple
User=makasna
Group=makasna
WorkingDirectory=/srv/makasna-dashboard
EnvironmentFile=/etc/makasna-dashboard.env
ExecStart=/srv/makasna-dashboard/.venv/bin/gunicorn --workers 1 --bind 0.0.0.0:${PORT} app:app
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
# ICMP diagnostics (ping) need raw sockets; grant only this capability.
AmbientCapabilities=CAP_NET_RAW
CapabilityBoundingSet=CAP_NET_RAW

[Install]
WantedBy=multi-user.target
