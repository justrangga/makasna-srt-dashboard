[Unit]
Description=Makasna STANDBY_SLATE idle graphics publisher (color bars + silence)
After=network-online.target mediamtx.service
Wants=mediamtx.service

[Service]
Type=simple
ExecStart=/usr/bin/ffmpeg -hide_banner -loglevel warning -re -f lavfi -i "testsrc2=size=1280x720:rate=25" -f lavfi -i "anullsrc=r=48000:cl=stereo" -c:v libx264 -preset ultrafast -tune zerolatency -b:v 800k -g 50 -pix_fmt yuv420p -c:a aac -b:a 96k -f mpegts "srt://127.0.0.1:8890?mode=caller&latency=200&streamid=publish:STANDBY_SLATE"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
